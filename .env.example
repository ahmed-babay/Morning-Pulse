# Backend
APP_NAME=Morning Pulse API
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL=INFO
HTTP__CONNECT_TIMEOUT_SECONDS=2
HTTP__READ_TIMEOUT_SECONDS=5
HTTP__RETRY_ATTEMPTS=3
RATE_LIMIT__ENABLED=true
RATE_LIMIT__REQUESTS=120
RATE_LIMIT__WINDOW_SECONDS=60
DATA__CACHE_TTL_SECONDS=900
DATA__CACHE_STALE_SECONDS=3600
DATA__NASA_API_KEY=DEMO_KEY

# Optional provider overrides (all defaults are public and keyless):
# DATA__COINGECKO_URL=https://api.coingecko.com/api/v3
# DATA__FRANKFURTER_URL=https://api.frankfurter.dev/v1
# DATA__NAGER_URL=https://date.nager.at/api/v3
# DATA__USGS_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary
# DATA__EONET_URL=https://eonet.gsfc.nasa.gov/api/v3
# DATA__LAUNCHES_URL=https://ll.thespacedevs.com/2.3.0
# DATA__APOD_URL=https://api.nasa.gov/planetary/apod
#
# Generic provider credentials remain available for future integrations:
# PROVIDERS__EXAMPLE__BASE_URL=https://api.example.com
# PROVIDERS__EXAMPLE__API_KEY=

# Frontend. Omit in production to use the same-origin /api/v1 proxy.
VITE_API_URL=http://localhost:8000/api/v1
